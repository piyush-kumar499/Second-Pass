# =============================================================================
#  Second Pass — environment template
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in what you have:
#      cp .env.example .env
#
#  Nothing here is required just to look at the app. With an empty AI section
#  the app still runs and clearly marks pages as sample drafts.
#  Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
#  1. Site
# -----------------------------------------------------------------------------
#  Used for absolute links in metadata. No trailing slash.
#  Local:      http://localhost:3000
#  Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
#  2. Database
# -----------------------------------------------------------------------------
#  Leave BOTH empty for the local SQLite file at data/dev.db (best for dev).
#  For Turso, create a database at https://turso.tech and paste:
#      TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#      TURSO_AUTH_TOKEN=eyJhbGciOi...
#  Then run: npm run db:migrate
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# -----------------------------------------------------------------------------
#  3. Login (Auth.js)
# -----------------------------------------------------------------------------
#  Session signing secret. Generate one with:
#      openssl rand -base64 32
#  (On Windows PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
AUTH_SECRET=

#  Google OAuth. Leave both empty to use the local email login instead.
#  Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#  → Web application. Authorised redirect URI:
#      http://localhost:3000/api/auth/callback/google
#  For production add:
#      https://your-domain.example/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

#  Local-only email login, so the app is testable before OAuth exists.
#  It switches itself off when Google is configured. Set false in production.
ALLOW_DEV_LOGIN=true

# -----------------------------------------------------------------------------
#  4. AI keys
# -----------------------------------------------------------------------------
#  Everything works without keys: generation falls back to a clearly marked
#  syllabus outline and the assistant says AI is not configured.
#
#  Groq (primary) — https://console.groq.com/keys
#  The free plan currently includes these chat models:
#      openai/gpt-oss-120b   best quality   (used for page generation + ingest)
#      openai/gpt-oss-20b    fastest        (used for chat)
#      qwen/qwen3.8-27b      preview        (optional)
#  One key is enough for every task. You may add up to four; they rotate.
GROQ_API1=
GROQ_API2=
GROQ_API3=
GROQ_API4=

#  Google Gemini (fallback when every Groq key fails)
#  https://aistudio.google.com/apikey
#  Free models include gemini-3.8-flash, gemini-4-hydrogen, gemini-3.6-flash
#  and gemini-3.5-flash-lite. The default below is gemini-3.8-flash.
GOOGLE_API1=

#  Optional model overrides. Leave empty to use the defaults in lib/ai/config.ts.
#  Groq default:   openai/gpt-oss-120b (generate/ingest)
#                  openai/gpt-oss-20b   (chat)
#  Gemini default: gemini-3.8-flash
MODEL_GENERATE=
MODEL_CHAT=
MODEL_INGEST=
MODEL_FALLBACK=

# -----------------------------------------------------------------------------
#  5. Admin
# -----------------------------------------------------------------------------
#  Comma-separated emails that can open /admin. Login with one of these
#  (Google or the dev email form) to approve data and publish pages.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
#  6. Limits and data version
# -----------------------------------------------------------------------------
#  Part of the page cache key (YYYY-MM). Bump it to make every page regenerate.
CURRENT_VERSION=2026-11

#  Per-user daily allowances.
DAILY_GEN_LIMIT_PER_USER=3
DAILY_CHAT_LIMIT_PER_USER=30

#  Hard stop for ALL AI calls per day, across every user.
GLOBAL_DAILY_AI_CALL_CAP=500
